Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Value: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Enabled: true
      Alpha: 1
  Global Options:
    Fixed Frame: base_link
  Views:
    - Class: rviz/Orbit
      Distance: 1.5
      Pitch: 0.5
      Yaw: 0.5
      Target Frame: base_link
