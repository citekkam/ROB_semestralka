<?xml version="1.0"?>
<robot name="crs_a465">
  <!-- Disable collisions between adjacent links connected by a joint -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="end_effector" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="hoop_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="hoop_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="end_effector" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="end_effector" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="hoop_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="end_effector" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="hoop_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="end_effector" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="hoop_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="tool_link" link2="end_effector" reason="Adjacent"/>
  <disable_collisions link1="tool_link" link2="hoop_adapter_link" reason="Adjacent"/>
  <disable_collisions link1="tool_link" link2="hoop_link" reason="Adjacent"/>
  <!-- Fixed attachments on the tool -->
  <disable_collisions link1="end_effector" link2="hoop_adapter_link" reason="Fixed"/>
  <disable_collisions link1="end_effector" link2="hoop_link" reason="Adjacent"/>
  <disable_collisions link1="hoop_adapter_link" link2="hoop_link" reason="Fixed"/>

  <!-- Minimal reference configuration so code can request 'half_sitting' -->
  <group_state name="half_sitting">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
</robot>
